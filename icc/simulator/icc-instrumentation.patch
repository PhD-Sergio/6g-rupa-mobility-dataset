+# Optional per-agent mobility override for mixed populations. Unset (default) keeps
+# the single configured model, so existing runs are unchanged. The picker is filled
+# by the run script from its own RNG, never from the simulation's global stream.
+# Handover hysteresis as a distance ratio; 1.0 keeps the nearest-gNB rule unchanged.
+const HANDOVER_HYSTERESIS = Ref(1.0)
+const AGENT_MOBILITY = Ref{Union{Nothing,Vector{MobilityModel}}}(nothing)
+agent_mobility_model(sim_state, user_id) =
+    AGENT_MOBILITY[] === nothing ? sim_state.config.mobility.model : AGENT_MOBILITY[][user_id]
+
